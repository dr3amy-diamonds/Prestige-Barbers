# ==================== CONFIGURACIÓN GENERAL ====================
NODE_ENV=development
PORT=3000

# ==================== JWT - AUTENTICACIÓN ====================
# CRÍTICO: Cambiar en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=prestige_barbers_secret_key_2025_CHANGE_IN_PRODUCTION_WITH_STRONG_RANDOM_KEY

# ==================== BASE DE DATOS MARIADB ====================
# Para Docker, usar 'mariadb' como host (nombre del servicio)
# Para localhost, usar 'localhost' o '127.0.0.1'
DB_HOST=mariadb
DB_PORT=3306
DB_USER=prestige_user
DB_PASSWORD=prestige_password123
DB_NAME=barberia
DB_ROOT_PASSWORD=rootpassword123

# ==================== CORS - ORÍGENES PERMITIDOS ====================
# Desarrollo: múltiples orígenes locales
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.36:3000

# Producción: solo dominios autorizados
# ALLOWED_ORIGINS=https://prestigebarbers.com,https://www.prestigebarbers.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ==================== ARCHIVOS ====================
MAX_FILE_SIZE=5242880

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== DOCKER PORTS ====================
# Puerto de la aplicación (cambiar si entra en conflicto)
APP_PORT=3000

# Puerto de la base de datos (cambiar si entra en conflicto)
DB_PORT_EXPOSE=3306

# Puerto de Adminer (herramienta web para BD) - opcional
ADMINER_PORT=8080
