# ==================== CONFIGURACIÓN DE SEGURIDAD - PRESTIGE BARBERS ====================
# IMPORTANTE: Copiar este archivo a .env y cambiar los valores en producción

# Entorno de ejecución (development, production)
NODE_ENV=development

# Puerto del servidor
PORT=3000

# ==================== JWT ====================
# Clave secreta para firmar tokens JWT
# CRÍTICO: Cambiar en producción con una clave aleatoria fuerte
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=prestige_barbers_secret_key_2025_CHANGE_IN_PRODUCTION_WITH_STRONG_RANDOM_KEY

# ==================== BASE DE DATOS ====================
# Configuración de MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=Barberia
DB_PORT=3306

# ==================== CORS ====================
# Orígenes permitidos (separados por comas)
# En desarrollo: múltiples orígenes locales
# En producción: solo tu dominio
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.36:3000

# Ejemplo para producción:
# ALLOWED_ORIGINS=https://prestigebarbers.com,https://www.prestigebarbers.com

# ==================== RATE LIMITING ====================
# Límite de peticiones por ventana de tiempo (15 minutos)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Límite específico para autenticación
AUTH_RATE_LIMIT_MAX=5

# ==================== MULTER (SUBIDA DE ARCHIVOS) ====================
# Tamaño máximo de archivo (en bytes) - 5MB por defecto
MAX_FILE_SIZE=5242880

# ==================== LOGGING ====================
# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# ==================== PRODUCCIÓN ====================
# Estos valores son críticos en producción:
# 
# 1. Generar JWT_SECRET fuerte:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 2. Configurar ALLOWED_ORIGINS con tu dominio real
#
# 3. Cambiar DB_PASSWORD con contraseña fuerte
#
# 4. Usar usuario de BD específico (no root)
#
# 5. Establecer NODE_ENV=production
